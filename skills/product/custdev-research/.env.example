# Один ключ Groq (минимальный вариант)
groq="gsk_your_groq_api_key_here"

# Несколько ключей для авто-ротации: лимиты Groq считаются на аккаунт И на модель
# (openai/gpt-oss-120b: 8k токенов/мин, 200k токенов/сутки; whisper: секунды аудио/сутки).
# Порядок = приоритет. Альтернатива: файл groq_keys.txt в корне проекта или ~/.groq_keys
GROQ_API_KEYS="gsk_key1,gsk_key2,gsk_key3"

# Корень проекта, где лежат Meets/transcripts и Meets/followups
# (по умолчанию определяется поиском вверх от текущей папки по признакам Meets/ или .git)
# CUSTDEV_BASE_DIR=/Users/you/project

# Путь к реестру исследований (по умолчанию <BASE_DIR>/Meets/реестр_кастдевов.md)
# CUSTDEV_REGISTRY=/Users/you/project/Meets/реестр_кастдевов.md

# Диаризация: бюджет токенов на окно, перехлёст, порог подозрительных прогонов
# DIARIZER_TOKEN_BUDGET=4000
# DIARIZER_OVERLAP=8
# DIARIZER_MAX_RUN=20
# DIARIZER_VERIFY_RUNS=0
