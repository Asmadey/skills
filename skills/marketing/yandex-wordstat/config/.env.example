# Yandex Cloud Search API credentials (CURRENT)
# Get API key at: https://yandex.cloud/ru/docs/searchapi/operations/auth
YANDEX_WORDSTAT_API_KEY=your_api_key_here

# Legacy OAuth token (DEPRECATED)
# api.wordstat.yandex.net/v1 is no longer reliable for new accounts.
# Keep only if you still have an approved legacy token.
# YANDEX_WORDSTAT_TOKEN=your_token_here

# Optional: legacy OAuth credentials (deprecated)
# YANDEX_CLIENT_ID=your_client_id
# YANDEX_CLIENT_SECRET=your_client_secret
