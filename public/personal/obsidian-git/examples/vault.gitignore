# ==========================================
# Идеальный .gitignore для хранилища Obsidian
# ==========================================

# 1. Системный мусор ОС
.DS_Store
Thumbs.db
desktop.ini

# 2. Корзина Obsidian
.trash/

# 3. Кэш рабочего пространства и позиции вкладок
# (Исключает постоянные мусорные коммиты при простом переключении заметок)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# 4. Временные и индексирующие файлы плагинов
.obsidian/graph.json
.obsidian/backlink.json
.obsidian/starred.json

# 5. Секреты плагинов (если какой-либо плагин хранит API-ключи в data.json)
# Раскомментируйте, если хотите скрыть настройки конкретного плагина:
# .obsidian/plugins/*/data.json

# 6. Кэш и временные артефакты
*.tmp
*.bak
